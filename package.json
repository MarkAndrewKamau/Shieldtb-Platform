{
  "name": "shieldtb-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @shieldtb/mobile",
    "mobile:android": "npm run android --workspace @shieldtb/mobile",
    "mobile:ios": "npm run ios --workspace @shieldtb/mobile",
    "mobile:web": "npm run web --workspace @shieldtb/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @shieldtb/mobile"
  }
}
